# Development creates a private local signing key when SECRET_KEY is absent.
# Compose requires a separate random key (at least 32 chars), including local use.
# Generate one locally: python -c 'import secrets; print(secrets.token_urlsafe(48))'
SECRET_KEY=
ENVIRONMENT=development
DATA_DIR=.data
DATABASE_PATH=database.db
PROJECTS_ROOT=projects
ALLOWED_HOSTS=["localhost","127.0.0.1"]
DJANGO_DEBUG=false
CORS_ORIGINS=[]
HTTP_CONCURRENCY=4
WORKER_CONCURRENCY=2

# Default: code stays on this machine. Start Ollama and pull the model first.
AI_PROVIDER=ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
OLLAMA_MODEL=qwen2.5-coder:7b
AI_TIMEOUT_SECONDS=60

# Cloud processing is opt-in; configure the key securely, never commit it.
ALLOW_CLOUD_AI=false
MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-small-latest

# Dollar prices per million tokens are operator supplied, not live provider prices.
# See README for budget semantics and limitations.
AI_MAX_COST_USD=0
AI_INPUT_COST_PER_MILLION=0
AI_OUTPUT_COST_PER_MILLION=0

# Compose only: source directory mounted read-only as /projects.
PROJECTS_DIRECTORY=./projects
# For Compose replace OLLAMA_BASE_URL above with http://ollama:11434/v1.
# Optional service image: pin a verified version or digest for deployment.
OLLAMA_IMAGE=ollama/ollama:latest
